{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "examples/reference-merchant/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/merchant"
    }
  ],
  "functions": {
    "api/merchant.ts": {
      "maxDuration": 30,
      "includeFiles": "{examples/reference-merchant/fonts/**,node_modules/harfbuzzjs/dist/**}"
    }
  },
  "crons": [
    {
      "path": "/admin/reconcile",
      "schedule": "0 3 * * *"
    }
  ],
  "regions": [
    "cdg1"
  ]
}
