# Copy to .env (gitignored). Never commit real values.
SATIM_ENVIRONMENT=certification
SATIM_USERNAME=
SATIM_PASSWORD=
SATIM_TERMINAL_ID=
# Required only when SATIM_ENVIRONMENT=production
SATIM_BASE_URL=

# Course store (MERCHANT_STORE=courses); see examples/reference-merchant/deploy/store.md
MERCHANT_STORE=
# OnlineCourseHost: Admin > Settings > Integrations > Zapier Integrations
OCH_INTEGRATION_TOKEN=
